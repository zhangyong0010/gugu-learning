{
  "name": "gugu-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "gugu-learning", "database_id": "REPLACE_AFTER_D1_CREATE" }],
  "vars": {
    "MINI_APP_URL": "REPLACE_AFTER_PAGES_DEPLOY",
    "ALLOWED_ORIGIN": "REPLACE_AFTER_PAGES_DEPLOY"
  }
}
